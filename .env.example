# Copy to .env (never commit real keys) or set these in your hosting dashboard.
GEMINI_API_KEY=            # from https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=gemini-flash-latest
DATABASE_URL=              # PostgreSQL URL, e.g. Supabase "Session pooler" string. Empty = local SQLite file
# AI_PROVIDER=openai       # optional: use an OpenAI-compatible API instead
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_MAX_CALLS_PER_MINUTE=12
