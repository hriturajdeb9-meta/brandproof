# Copy to .env for local runs (never commit real keys) or set these in your hosting dashboard.
# Everything is optional: with nothing set, Brandproof runs on a local SQLite file with code checks only.

GEMINI_API_KEY=            # main AI, free key from https://aistudio.google.com/apikey
GROQ_API_KEY=              # backup AI + independent second opinion, free key from https://console.groq.com/keys
DATABASE_URL=              # PostgreSQL URL, e.g. Supabase "Session pooler" string. Empty = local SQLite file

# Sign-in: with these two set, accounts use Supabase Auth; otherwise Brandproof's built-in accounts.
SUPABASE_URL=              # https://<project>.supabase.co
SUPABASE_ANON_KEY=         # the public "anon" key (NOT the service-role key)
SESSION_SECRET=            # optional random string for signing session cookies

# Choosing models per job (first one that answers wins; steps without a key are skipped)
# AI_ROUTE_CLAIMS=gemini:gemini-2.5-flash,gemini:gemini-flash-latest,groq:openai/gpt-oss-120b
# AI_ROUTE_TONE=...        AI_ROUTE_IMAGE=...   AI_ROUTE_VERIFY=...   AI_ROUTE_IMPORT=...   AI_ROUTE_CLARIFY=...
# AI_ROUTE=...             # every text job at once
# AI_PROVIDER=none         # switch AI off (code checks only); "fake" is used by the tests
# AI_TIMEOUT_SECONDS=25
# AI_MAX_CALLS_PER_MINUTE=12   GROQ_MAX_CALLS_PER_MINUTE=25
# OPENAI_API_KEY= / OPENAI_BASE_URL= / OPENAI_MODEL=   any OpenAI-compatible API, as "openai:<model>" in a route
